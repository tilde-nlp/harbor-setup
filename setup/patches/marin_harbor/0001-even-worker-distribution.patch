 }
 _last_worker_poll = 0.0
 
+# Per-node bookkeeping for START placement: node_id -> {"last_poll", "capacity"}.
+# A node is "active" while it has polled within NODE_ACTIVE_SEC; only active nodes
+# take part in the least-loaded comparison, so a node that died or whose dispatcher
+# is blocked stops holding START jobs back from the others.
+_nodes: dict = {}
+NODE_ACTIVE_SEC = 30.0
+LIVE_STATES = (ENV_STARTING, ENV_READY, ENV_STOPPING)
+
+
+def _live_envs_by_node():
+    """Number of envs each node currently owns that still occupy a sandbox."""
+    counts: dict = {}
+    for env in _envs.values():
+        if env["state"] in LIVE_STATES and env.get("node_id"):
+            counts[env["node_id"]] = counts.get(env["node_id"], 0) + 1
+    return counts
+
+
+def _start_allowance(node_id, now):
+    """How many START jobs `node_id` may take from the general queue right now.
+
+    Placement rule (least-loaded): a node may take a START only while its live env
+    count is not above the lowest live count among the active nodes, and only while
+    it is below its own capacity. One START per poll, so that the other nodes get a
+    turn: with idle polling at <=2 s and a resubmit interval of ~0.5 s per trajectory
+    (SkyRL's rate limiter) this alternates cleanly. Returns 0 to hold back.
+
+    Before this rule the general queue was drained into whichever dispatcher polled
+    first, with `count` = its thread count, so one node could own the whole batch of
+    sandboxes while the others stayed idle.
+    """
+    live = _live_envs_by_node()
+    my_live = live.get(node_id, 0)
+    info = _nodes.get(node_id, {})
+    capacity = info.get("capacity")
+    if capacity is not None and my_live >= capacity:
+        return 0
+    active = [
+        n for n, i in _nodes.items() if (now - i["last_poll"]) < NODE_ACTIVE_SEC
+    ]
+    if not active:
+        return 1
+    min_live = min(live.get(n, 0) for n in active)
+    return 1 if my_live <= min_live else 0
+
+
+def _note_poll(node_id, capacity, now):
+    """Record that `node_id` polled; remember its capacity when it reports one."""
+    info = _nodes.setdefault(node_id, {"last_poll": now, "capacity": None})
+    info["last_poll"] = now
+    if capacity is not None:
+        info["capacity"] = capacity
+
 
