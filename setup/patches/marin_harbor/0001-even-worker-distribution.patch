 _instances_lock = threading.Lock()
 
+# Jobs currently being executed by this node's worker threads, by type, for the
+# periodic status line (see _status_loop). Guarded by _in_flight_lock.
+_in_flight: dict = {"start": 0, "exec": 0, "upload": 0, "download": 0, "stop": 0}
+_in_flight_lock = threading.Lock()
+
+
+def _in_flight_add(job_type, delta):
+    with _in_flight_lock:
+        _in_flight[job_type] = _in_flight.get(job_type, 0) + delta
+
+
+def _status_line(hostname, num_workers, job_queue):
+    """One-line snapshot of what this node is holding and doing right now."""
+    with _instances_lock:
+        live = len(_instances)
+    with _pool_lock:
+        pooled = sum(len(b) for b in _instance_pool.values())
+    with _in_flight_lock:
+        f = dict(_in_flight)
+    busy = sum(f.values())
+    return (
+        f"[{hostname}] status: sandboxes={live} live"
+        f" (+{f['start']} starting, +{pooled} pooled idle)"
+        f" | threads busy {busy}/{num_workers}"
+        f" (exec={f['exec']} upload={f['upload']} download={f['download']}"
+        f" stop={f['stop']}) | local queue={job_queue.qsize()}"
+    )
+
+
+def _status_loop(hostname, num_workers, job_queue, interval):
+    """Print the node status line every `interval` seconds, and immediately
+    whenever the live sandbox count changed since the last line."""
+    last_live = -1
+    last_print = 0.0
+    while True:
+        time.sleep(1.0)
+        with _instances_lock:
+            live = len(_instances)
+        now = time.time()
+        if live != last_live or (now - last_print) >= interval:
+            print(_status_line(hostname, num_workers, job_queue), flush=True)
+            last_live, last_print = live, now
+
 
