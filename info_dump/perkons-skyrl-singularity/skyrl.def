Bootstrap: docker
From: novaskyai/skyrl-train-ray-2.56.0-py3.12-cu12.8

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        fuse3 squashfuse fuse-overlayfs uidmap ca-certificates curl wget git

    # Non-setuid apptainer, same version as the host. Installing apptainer-suid
    # here would be useless: suid binaries do not execute under a nosuid mount.
    curl -fsSL -o /tmp/apptainer.deb \
        https://github.com/apptainer/apptainer/releases/download/v1.5.3/apptainer_1.5.3_amd64.deb
    apt-get install -y /tmp/apptainer.deb
    rm /tmp/apptainer.deb
    ln -sf /usr/bin/apptainer /usr/local/bin/singularity

    apt-get clean && rm -rf /var/lib/apt/lists/*
    mkdir -p /work

%environment
    export RAY_RUNTIME_ENV_HOOK=ray._private.runtime_env.uv_runtime_env_hook.hook
    export APPTAINER_USERNS=1
    export SINGULARITY_USERNS=1